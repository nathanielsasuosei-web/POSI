{
  "name": "posi-api",
  "private": true,
  "version": "1.0.0",
  "description": "POSI pharmacy operations backend (Express + PostgreSQL)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migrate.js",
    "seed": "node src/seed.js",
    "reset": "node src/migrate.js --reset && node src/seed.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  }
}
