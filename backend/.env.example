# ---------------------------------------------------------------
# POSI backend configuration
# Copy this file to backend/.env and fill in the values.
# Never commit backend/.env — it holds database credentials.
# ---------------------------------------------------------------

# PostgreSQL connection string.
# Supabase (Project settings -> Database -> Connection string -> URI).
# Use the "Session pooler" / "Transaction pooler" host if your network is
# IPv6-only blocked; the direct db.<ref>.supabase.co host is IPv6-only.
DATABASE_URL=postgresql://postgres.REPLACE_ME:REPLACE_ME@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Force SSL on/off. Leave unset for automatic detection (SSL for remote hosts).
# DB_SSL=true

# Port the API listens on. The Vite dev server proxies /api here.
PORT=8787

# Comma separated list of browser origins allowed to call the API.
# Leave empty when the API is served behind the same origin as the app.
CORS_ORIGINS=

# Apply pending SQL migrations and seed demo data on boot.
AUTO_MIGRATE=true
SEED_ON_EMPTY=true

# Abort an API query that runs longer than this.
DB_STATEMENT_TIMEOUT_MS=15000
